{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/openchat",
      "destination": "https://openchat-liart-one.vercel.app/openchat"
    },
    {
      "source": "/openchat/:path*",
      "destination": "https://openchat-liart-one.vercel.app/openchat/:path*"
    }
  ]
}
