{
  "name": "rift4.github.io",
  "build": {
    "dockerfile": "../Containerfile",
    "context": ".."
  },
  "workspaceFolder": "/srv/www",
  "workspaceMount": "source=${localWorkspaceFolder},target=/srv/www,type=bind",
  "remoteUser": "node",
  "runArgs": [
    "--userns=keep-id"
  ],
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "rift4.github.io",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "davidanson.vscode-markdownlint",
        "ecmel.vscode-html"
      ]
    }
  }
}
